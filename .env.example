PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-production
DATABASE_PATH=.data/wakwito.sqlite

# Optional first-run production administrator bootstrap
ADMIN_NAME=Wakwito Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=replace-with-a-unique-password

# Africa's Talking SMS approval notifications
AT_ENV=sandbox
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# SMTP email approval notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_SITE_URL=http://localhost:5173

# Safaricom Daraja STK Push (set all values together to enable M-Pesa)
MPESA_ENV=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback
